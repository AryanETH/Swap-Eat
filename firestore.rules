rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function listingPath(id) {
      return /databases/$(database)/documents/listings/$(id);
    }
    function requestPath(id) {
      return /databases/$(database)/documents/requests/$(id);
    }
    function active(listing) {
      return listing.status == 'available' &&
        listing.pickupAt > request.time.toMillis();
    }
    function validListing(d) {
      return d.keys().hasOnly(['title','category','mode','provider','area','servings',
          'price','pickup','pickupAt','ingredients','owner','status','createdAt','providerName','location','photoCount']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 70 &&
        d.category in ['Meals','Bakery','Produce'] &&
        d.mode in ['Share','Swap','Deal'] &&
        d.provider in ['Community','Kitchen','Restaurant','Café','Store'] &&
        d.area in ['Lalghati','Karond','Gandhi Nagar','Other'] &&
        d.servings is int && d.servings >= 1 && d.servings <= 100 &&
        d.price is number && (d.mode == 'Deal' ? d.price > 0 && d.price <= 10000 : d.price == 0) &&
        d.providerName is string && d.providerName.size() > 0 && d.providerName.size() <= 60 &&
        d.location.keys().hasOnly(['lat','lng']) &&
        d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90 &&
        d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180 &&
        d.photoCount is int && d.photoCount >= 0 && d.photoCount <= 3 &&
        d.pickup is string && d.pickup.size() == 24 && d.pickupAt is int &&
        d.ingredients is string && d.ingredients.size() > 0 && d.ingredients.size() <= 400 &&
        d.createdAt is int && d.owner == request.auth.uid && active(d);
    }
    match /listings/{listingId} {
      function photoOk(photo) {
        return photo is string && photo.size() <= 120000 && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }
      match /media/photos {
        allow read: if true;
        allow create: if signedIn() && !exists(listingPath(listingId)) &&
          getAfter(listingPath(listingId)).data.owner == request.auth.uid &&
          request.resource.data.keys().hasOnly(['photos']) &&
          request.resource.data.photos is list &&
          request.resource.data.photos.size() == getAfter(listingPath(listingId)).data.photoCount &&
          request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 3 &&
          photoOk(request.resource.data.photos[0]) &&
          (request.resource.data.photos.size() < 2 || photoOk(request.resource.data.photos[1])) &&
          (request.resource.data.photos.size() < 3 || photoOk(request.resource.data.photos[2]));
      }
      allow read: if true;
      allow create: if signedIn() && validListing(request.resource.data) &&
        (request.resource.data.photoCount == 0 ||
          existsAfter(/databases/$(database)/documents/listings/$(listingId)/media/photos));
      allow update: if signedIn() && resource.data.owner == request.auth.uid &&
        resource.data.status == 'available' && (
          (request.resource.data.status == 'removed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
          (active(resource.data) && request.resource.data.status == 'reserved' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedRequest']) &&
            getAfter(requestPath(request.resource.data.acceptedRequest)).data.listing == listingId &&
            getAfter(requestPath(request.resource.data.acceptedRequest)).data.status == 'accepted')
        );
    }
    function validRequest(id, d, listing) {
      return d.keys().hasOnly(['listing','title','owner','buyer','pickup','message','status','createdAt']) &&
        d.listing is string && id == d.listing + '_' + request.auth.uid &&
        d.owner == listing.owner && d.buyer == request.auth.uid && d.owner != d.buyer &&
        d.title == listing.title && d.pickup == listing.pickup &&
        d.status == 'pending' && d.createdAt is int && d.message is string &&
        d.message.size() <= 350 && (listing.mode != 'Swap' || d.message.size() > 0) &&
        active(listing);
    }
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.owner == request.auth.uid ||
        resource.data.buyer == request.auth.uid);
      allow create: if signedIn() && validRequest(id, request.resource.data,
        get(listingPath(request.resource.data.listing)).data);
      allow update: if signedIn() && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','pickupNote']) &&
        request.resource.data.pickupNote is string && request.resource.data.pickupNote.size() <= 350 && (
          (request.resource.data.status == 'cancelled' && request.auth.uid == resource.data.buyer &&
            request.resource.data.pickupNote == '') ||
          (request.resource.data.status == 'declined' && request.auth.uid == resource.data.owner &&
            request.resource.data.pickupNote == '') ||
          (request.resource.data.status == 'accepted' && request.auth.uid == resource.data.owner &&
            request.resource.data.pickupNote.size() > 0 &&
            getAfter(listingPath(resource.data.listing)).data.status == 'reserved' &&
            getAfter(listingPath(resource.data.listing)).data.acceptedRequest == id)
        );
    }
  }
}
